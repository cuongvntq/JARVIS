# ============================================================
# J.A.R.V.I.S Environment Variables Template
# Copy this file to .env and fill in real values
# DO NOT commit .env to git
# ============================================================

# -------- App --------
APP_NAME=jarvis
APP_ENV=development                    # development | staging | production
LOG_LEVEL=INFO
TIMEZONE_DEFAULT=Asia/Ho_Chi_Minh

# -------- Server --------
BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_CORS_ORIGINS=http://localhost:3000

# -------- Database (Supabase Postgres) --------
# Lấy từ Supabase project settings → Database → Connection string (transaction pooler, port 6543)
DATABASE_URL=postgresql+asyncpg://postgres.xxxxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# Direct connection (cho Alembic migration, port 5432)
DATABASE_URL_DIRECT=postgresql+psycopg2://postgres.xxxxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# -------- LLM Providers --------
# Gemini API (FREE 1500 req/ngày, KHÔNG CẦN credit card)
# Lấy tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI (fallback, ~$5 free credit cho account mới)
# Lấy tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic (optional, cho fallback chain dài hơn)
# ANTHROPIC_API_KEY=sk-ant-...

# -------- LLM Routing Config --------
LLM_PRIMARY=gemini/gemini-2.5-flash
LLM_FALLBACK=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS_OUT=1000

# -------- Embedding --------
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# -------- Auth --------
# Random 32+ ký tự. Tạo bằng: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# -------- Cookie --------
# Browser cross-site (Vercel frontend → Railway backend):
#   COOKIE_SAMESITE=none  COOKIE_SECURE=true  (HTTPS bắt buộc khi samesite=none)
# Same-site hoặc local dev: giữ default (lax / false)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=                             # set nếu FE/BE cùng domain gốc (ví dụ .jarvis.app)

# -------- Google OAuth --------
# Tạo tại: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -------- Web Push (VAPID) --------
# Generate bằng: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# -------- Redis (Upstash, optional ở MVP1) --------
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# -------- Observability --------
# SENTRY_DSN=
# BETTERSTACK_LOGS_TOKEN=
